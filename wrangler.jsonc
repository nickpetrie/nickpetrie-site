{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nickpetrie-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Runs before every `wrangler deploy`, including Cloudflare's Git builds, so dist/ is always fresh.
  "build": { "command": "npm run build" },
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "BEEHIIV_PUBLICATION_ID": "pub_dc13bc61-8017-4e9f-9827-57bbd16ff777"
  },
  "observability": { "enabled": true }
  // Secret, set once with: npx wrangler secret put BEEHIIV_API_KEY
  // Custom domain (www.nickpetrie.co) is added at cutover, not before.
}
