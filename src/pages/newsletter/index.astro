---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Wnmp from '../../components/Wnmp.astro';
import { getPosts, breadcrumbs } from '../../lib/content';
import { site, newsletter, person } from '../../site';

const issues = (await getPosts()).filter((p) => p.data.newsletter);
---
<Base
  title={`${newsletter.name}: a newsletter by Nick Petrie`}
  description={newsletter.description}
  jsonLd={[
    {
      '@type': 'CreativeWorkSeries',
      '@id': `${newsletter.url}#series`,
      name: newsletter.name,
      alternateName: newsletter.short,
      url: newsletter.url,
      description: newsletter.description,
      author: { '@id': person['@id'] },
      inLanguage: site.lang,
      hasPart: issues.map((p) => ({ '@id': `${site.url}/${p.id}/#article` })),
    },
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Newsletter', path: '/newsletter/' }]),
  ]}
>
  <Wnmp id="newsletter" heading />
  <section class="block"><p class="lede">Essays on news product, teams and strategy, from someone doing the work. Each issue is an argument, a few links worth your time, and an invitation to reply.</p></section>
  <section class="block" aria-labelledby="past">
    <h2 class="label" id="past">Past issues</h2>
    <PostList posts={issues} />
  </section>
</Base>
