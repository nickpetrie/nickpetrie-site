---
// Topic hubs. Strong topics get an intro and are indexed; thin ones stay online but out of search.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, breadcrumbs } from '../../../lib/content';
import { site, person } from '../../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = await getCollection('tags');
  return tags
    .map((tag) => ({ params: { slug: tag.id }, props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag.id)) } }))
    .filter((x) => x.props.posts.length > 0);
}

interface Props { tag: CollectionEntry<'tags'>; posts: CollectionEntry<'posts'>[] }
const { tag, posts } = Astro.props;
const name = tag.data.name;
const url = `${site.url}/tag/${tag.id}/`;
const description = tag.data.description ?? `Nick Petrie's writing on ${name.toLowerCase()}.`;
const topics = (await getCollection('tags')).filter((t) => !t.data.noindex);
// Indexable posts first, so the hub leads with the substantial pieces.
const ordered = [...posts.filter((p) => !p.data.noindex), ...posts.filter((p) => p.data.noindex)];
---
<Base
  title={name}
  description={description}
  noindex={tag.data.noindex}
  section="/writing/"
  jsonLd={[
    {
      '@type': 'CollectionPage',
      '@id': `${url}#page`,
      url,
      name,
      description,
      about: { '@type': 'Thing', name },
      author: { '@id': person['@id'] },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: ordered.filter((p) => !p.data.noindex).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/${p.id}/` })),
      },
    },
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Writing', path: '/writing/' }, { name, path: `/tag/${tag.id}/` }]),
  ]}
>
  <p class="label"><a href="/writing/">Writing</a> · Topic</p>
  <h1 class="page-h1">{name}</h1>
  {tag.data.intro ? <p class="lede" set:html={tag.data.intro} /> : <p class="lede">{description}</p>}
  {!tag.data.noindex && (
    <nav aria-label="Topics">
      <ul class="chips">
        <li><a href="/writing/">All</a></li>
        {topics.map((t) => <li><a href={`/tag/${t.id}/`} aria-current={t.id === tag.id ? 'page' : undefined}>{t.data.name}</a></li>)}
      </ul>
    </nav>
  )}
  <section class="block"><PostList posts={ordered} headingLevel="h2" /></section>
</Base>
