---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { getPosts, breadcrumbs } from '../../lib/content';
import { site } from '../../site';

const posts = await getPosts();
const topics = (await getCollection('tags')).filter((t) => !t.data.noindex);
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
const description = 'Everything Nick Petrie has written on news product, newsroom strategy, leadership and mentoring, by year.';
---
<Base
  title="Writing"
  description={description}
  jsonLd={[
    {
      '@type': 'CollectionPage',
      '@id': `${site.url}/writing/#page`,
      url: `${site.url}/writing/`,
      name: 'Writing by Nick Petrie',
      description,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: posts.filter((p) => !p.data.noindex).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/${p.id}/` })),
      },
    },
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Writing', path: '/writing/' }]),
  ]}
>
  <h1 class="page-h1">Writing</h1>
  <p class="lede">Everything I've written on news product, newsroom strategy, leadership and mentoring.</p>
  <nav aria-label="Topics">
    <ul class="chips">
      <li><a href="/writing/" aria-current="page">All</a></li>
      {topics.map((t) => <li><a href={`/tag/${t.id}/`}>{t.data.name}</a></li>)}
    </ul>
  </nav>
  {years.map((year) => (
    <section class="year">
      <h2 id={`y${year}`}>{year}</h2>
      <PostList posts={posts.filter((p) => p.data.date.getFullYear() === year)} summary={false} />
    </section>
  ))}
</Base>
