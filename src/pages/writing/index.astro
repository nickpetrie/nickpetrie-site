---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { getPosts, breadcrumbs } from '../../lib/content';
import { site } from '../../site';

const posts = await getPosts();
const tags = (await getCollection('tags'))
  .map((t) => ({ t, n: posts.filter((p) => p.data.tags.includes(t.id)).length }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n);
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
const description = 'Everything Nick Petrie has written on news product, newsroom strategy, leadership and mentoring, by year.';
---
<Base
  title="Writing"
  description={description}
  jsonLd={[
    {
      '@type': 'CollectionPage',
      '@id': `${site.url}/writing/#page`,
      url: `${site.url}/writing/`,
      name: 'Writing by Nick Petrie',
      description,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/${p.id}/` })),
      },
    },
    breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Writing', path: '/writing/' }]),
  ]}
>
  <div class="wrap">
    <h1>Writing</h1>
    <p class="lede">{description}</p>
    <ul class="tags" aria-label="Topics">
      {tags.map(({ t, n }) => <li><a href={`/tag/${t.id}/`}>{t.data.name} <span>({n})</span></a></li>)}
    </ul>
    {years.map((year) => (
      <section>
        <h2 id={`y${year}`}>{year}</h2>
        <PostList posts={posts.filter((p) => p.data.date.getFullYear() === year)} headingLevel="h3" />
      </section>
    ))}
  </div>
</Base>
