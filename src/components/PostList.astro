---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  headingLevel?: 'h2' | 'h3';
  summary?: boolean;
}
const { posts, headingLevel: H = 'h3', summary = true } = Astro.props;
---
<ol class:list={['entries', { compact: !summary }]}>
  {posts.map((post) => (
    <li class="entry">
      <H><a href={`/${post.id}/`}>{post.data.title}</a></H>
      <p class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
      {summary && <p class="sum">{post.data.standfirst ?? post.data.description}</p>}
    </li>
  ))}
</ol>
