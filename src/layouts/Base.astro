---
import Seo from '../components/Seo.astro';
import SignupForm from '../components/SignupForm.astro';
import '../styles/global.css';
import { site, newsletter } from '../site';
import { npMarkSvg } from '../lib/brand';

type SeoProps = import('astro/types').ComponentProps<typeof Seo>;
interface Props extends SeoProps {
  section?: string; // nav item to mark as current when the path doesn't say, e.g. posts under Writing
}

const { section, ...props } = Astro.props;
const path = Astro.url.pathname;
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const current = (href: string) => path.startsWith(href) || href === section;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/SourceSerif4-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SourceSans3-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#F7F6F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F2834" media="(prefers-color-scheme: dark)" />
    <Seo {...props} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="head wrap">
      <a class="brand" href="/"><Fragment set:html={npMarkSvg} /><span>Nick Petrie</span></a>
      <nav aria-label="Main">
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu"><span class="menu-icon" aria-hidden="true"></span>Menu</button>
        <ul id="menu">
          {site.nav.map((item) => (
            <li><a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <script is:inline>
      // Phones only: the menu button opens the nav as a panel. Without JS the links simply show.
      const btn = document.querySelector('.menu-btn');
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        btn.closest('.head').classList.toggle('open', open);
      });
    </script>

    <main id="main" class="wrap">
      <slot />
    </main>
    <slot name="after-main" />

    <footer class="foot">
      <div class="wrap foot-in">
        <div>
          <p class="foot-name">Nick Petrie</p>
          <p class="small">
            <a href={`mailto:${site.email}`}>{site.email}</a><br />
            <a href={site.social.linkedin} rel="me">LinkedIn</a> · <a href={site.social.x} rel="me">X</a> · <a href={site.social.mastodon} rel="me">Mastodon</a> · <a href="/rss/">RSS</a><br />
            <a href="/contact/">Contact and colophon</a>
          </p>
        </div>
        <div>
          <p class="foot-label">{newsletter.name}</p>
          <p class="small">{newsletter.promise}</p>
          <SignupForm id="footer" />
        </div>
      </div>
    </footer>

    {analyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })} is:inline></script>
    )}
  </body>
</html>
